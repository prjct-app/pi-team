{
  "name": "@prjct.app/pi-team",
  "version": "0.5.6",
  "description": "Coordinate independent PI Agent sessions with local team messaging, queued tasks, and shared results.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "pi-coding-agent",
    "pi-extension",
    "ai-coding",
    "developer-tools",
    "multi-agent",
    "agent-collaboration",
    "messaging",
    "task-queue",
    "local-first"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "image": "https://raw.githubusercontent.com/prjct-app/pi-clipboard/main/docs/covers/pi-team.png"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run check:immutable",
    "check:immutable": "! grep -rn '\\blet\\b' src/ || (echo 'Use immutable values: no let bindings in src/' && exit 1)",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.mjs",
    "check:package": "npm pack --dry-run --ignore-scripts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "^22.19.0",
    "tsx": "^4.20.0",
    "typebox": "1.3.7",
    "typescript": "^5.9.3"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prjct-app/pi-team.git"
  },
  "homepage": "https://github.com/prjct-app/pi-team#readme",
  "bugs": {
    "url": "https://github.com/prjct-app/pi-team/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.ts",
    "src",
    "docs",
    "!docs/cover.png",
    "README.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "CHANGELOG.md"
  ]
}
